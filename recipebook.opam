opam-version: "2.0"
synopsis:
  "A personalized recipe book that recommends recipes from a few questions"
authors: ["Alicia He" "Claire Yan" "Daisy Yin" "Jennifer Wu" "Mindi Hu"]
license: "LICENSE"
homepage: "https://github.com/mindi888/CS3110-Project"
